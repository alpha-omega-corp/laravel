{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "alpha-omega-corp/ui-kit",
    "type": "library",
    "description": "The shared UI kit: themed Blade components and the Tailwind Plus reference library, installed with `php artisan ui:kit`.",
    "keywords": [
        "laravel",
        "blade",
        "tailwind"
    ],
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "illuminate/console": "^13.23",
        "illuminate/filesystem": "^13.23",
        "illuminate/support": "^13.23"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "larastan/larastan": "^3.9",
        "laravel/ai": "^0.11.2",
        "laravel/boost": "^2.9",
        "laravel/framework": "^13.23",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "laravel/sail": "^1.53",
        "laravel/tinker": "^3.0",
        "livewire/blaze": "^1.0",
        "livewire/livewire": "^4.1",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9.3",
        "orchestra/testbench": "^11.2",
        "pestphp/pest": "^5.2",
        "pestphp/pest-plugin-laravel": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "AlphaOmega\\UiKit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "npm install",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#fdba74\" \"php vendor/bin/testbench serve --ansi\" \"npm run dev\" --names=server,vite --kill-others"
        ],
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "lint": [
            "pint --parallel"
        ],
        "lint:check": [
            "pint --parallel --test"
        ],
        "ci:check": [
            "Composer\\Config::disableProcessTimeout",
            "@test"
        ],
        "types:check": [
            "phpstan analyse"
        ],
        "test": [
            "@php vendor/bin/testbench config:clear --ansi",
            "@lint:check",
            "@types:check",
            "@php vendor/bin/pest"
        ],
        "post-autoload-dump": [
            "@php vendor/bin/testbench package:discover --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "AlphaOmega\\UiKit\\UiKitServiceProvider"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
